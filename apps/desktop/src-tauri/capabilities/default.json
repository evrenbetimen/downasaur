{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "clipboard-manager:allow-read-text",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path"
  ]
}
